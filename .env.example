# Copie para .env e ajuste. O .env NUNCA vai para o git.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere um novo: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-em-qualquer-ambiente-real
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=sistemabet
POSTGRES_USER=sistemabet
POSTGRES_PASSWORD=sistemabet
POSTGRES_HOST=db
POSTGRES_PORT=5432

# E-mail. Em desenvolvimento as mensagens saem no console; em producao estas
# tres sao obrigatorias e a aplicacao se recusa a subir sem elas.
DEFAULT_FROM_EMAIL=nao-responda@localhost
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Dados da operacao exibidos no rodape (licenca, registro, agente de pagamento).
# Tem padrao no codigo; sobrescreva aqui quando a autorizacao mudar.
# OPERACAO_RAZAO_SOCIAL=
# OPERACAO_REGISTRO=
# OPERACAO_ENDERECO=
# OPERACAO_LICENCA=
# OPERACAO_LICENCIADOR=
# OPERACAO_AGENTE_PAGAMENTO=
